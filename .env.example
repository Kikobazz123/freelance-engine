# Copy to .env and fill in. NEVER commit .env.
# Every one of these must ALSO be added at cloud.trigger.dev -> project -> Environment
# Variables, for BOTH staging and prod. Missing dashboard vars are the #1 deploy failure.

# --- Neon (already provisioned: project blue-surf-57027129) -------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# --- Telegram ----------------------------------------------------------------
# Create a bot with @BotFather, then message it once and read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Gmail (reuse the OAuth client from lordgen-daily-report) -----------------
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_SENDER="you@example.com"

# Cold outreach: intentionally sends from the Gmail above at low volume rather
# than a separate domain. A warmed domain matters above ~100 sends/day; an
# unwarmed new one would deliver worse. Revisit at volume.
COLD_OUTREACH_FROM=""

# --- LLM for proposal generation (ALL FREE TIER) -----------------------------
# Chain order is groq -> gemini -> openrouter -> labelled stub. Any one of these
# alone covers the pipeline; the chain exists so a rate limit is not an outage.
# Groq is primary: 30 req/min, 14,400/day, no credit card.
GROQ_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""

# Optional model overrides. Free-tier model names get retired without notice, so
# these are env-driven rather than hardcoded.
# GROQ_MODEL="qwen/qwen3.8-27b"
# GEMINI_MODEL="gemini-flash-lite-latest"
# OPENROUTER_MODEL="deepseek/deepseek-v4-flash-0731:free"

# --- Trigger.dev --------------------------------------------------------------
# Public project identifier, not a secret. Create a NEW project - do not reuse
# lordgen-daily-report, deploying would overwrite its tasks.
TRIGGER_PROJECT_REF=""

# --- Safety ------------------------------------------------------------------
# DRY_RUN=true generates everything and sends nothing. Leave true until the
# end-to-end dry run has been inspected.
DRY_RUN="true"
