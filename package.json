{
  "name": "freelance-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "trigger.dev dev",
    "deploy": "trigger.dev@4.4.0 deploy",
    "pipeline": "tsx scripts/run-pipeline.ts",
    "pipeline:csv": "tsx scripts/run-pipeline.ts --csv",
    "backfill": "tsx scripts/backfill-market.ts",
    "geo:audit": "tsx scripts/geo-audit.ts",
    "check": "tsx scripts/check-keys.ts",
    "verify": "tsx scripts/verify-all.ts",
    "gmail-oauth-setup": "tsx scripts/gmail-oauth-setup.ts",
    "card:test": "tsx scripts/send-test-card.ts",
    "cv": "python scripts/build_docx.py",
    "approvals": "tsx scripts/approvals.ts",
    "migrate": "tsx scripts/migrate.ts",
    "dry-run": "tsx scripts/dry-run.ts",
    "env:push": "tsx scripts/push-env.ts",
    "env:push:prod": "tsx scripts/push-env.ts --env prod",
    "check:deploy": "tsx scripts/check-deploy.ts",
    "now": "tsx scripts/run-now.ts",
    "digest": "tsx scripts/digest.ts",
    "verify:chain": "tsx scripts/verify.ts && tsx scripts/verify-extra.ts && tsx scripts/verify-callbacks.ts && tsx scripts/verify-lane-a.ts && tsx scripts/verify-digest.ts",
    "kits": "tsx scripts/kits.ts",
    "dev:functions": "tsx scripts/dev-server.ts",
    "dev:inngest": "node scripts/dev-inngest.mjs",
    "cutover": "node scripts/cutover.mjs",
    "job": "node scripts/job.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@trigger.dev/sdk": "4.4.0",
    "@vercel/functions": "^3.9.9",
    "inngest": "^4.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.2",
    "dotenv": "^16.4.5",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "trigger.dev": "4.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
